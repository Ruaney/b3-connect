    "scenario_2_fifo_queue_priority_test": {
      "description": "Verificação estrita da regra FIFO: redução mantém prioridade; aumento perde prioridade para o final da fila.",
      "initial_orders": [
        {"order_id": 3001, "price": "40.00", "quantity": 1000, "timestamp": "2026-11-05T10:05:00.000000Z"},
        {"order_id": 3002, "price": "40.00", "quantity": 2000, "timestamp": "2026-11-05T10:05:00.000100Z"},
        {"order_id": 3003, "price": "40.00", "quantity": 3000, "timestamp": "2026-11-05T10:05:00.000200Z"}
      ],
      "modifications": [
        {
          "step": "reduction_keeps_priority",
          "order_id": 3002,
          "new_quantity": 1200,
          "expected_queue_order": [3001, 3002, 3003],
          "expected_level_quantity": 5200
        },
        {
          "step": "increase_loses_priority",
          "order_id": 3001,
          "new_quantity": 1500,
          "expected_queue_order": [3002, 3003, 3001],
          "expected_level_quantity": 5700
        }
      ]
    },
